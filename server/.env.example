# Copy to .env (never commit .env).

# Postgres connection string. Neon: Dashboard -> Connection string (pooled is fine).
DATABASE_URL=postgres://user:password@localhost:5432/pulsefit

# Public URL of the frontend. Requests from other sites are refused, and the
# session cookie is marked Secure when this starts with https. Comma-separate for more than one.
CLIENT_URL=http://localhost:5173

PORT=4000

# Stripe, test mode. Dashboard -> Developers -> API keys (the sk_test_... secret key).
STRIPE_SECRET_KEY=

# Signing secret for the webhook (whsec_...). Locally: printed by `stripe listen`.
# Deployed: shown on the webhook endpoint's page in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
