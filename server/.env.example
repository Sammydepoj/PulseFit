# Copy to .env (never commit .env).

# Postgres connection string. Neon: Dashboard -> Connection string (pooled is fine).
DATABASE_URL=postgres://user:password@localhost:5432/pulsefit

# Long random string used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of THIS server (no trailing slash).
BETTER_AUTH_URL=http://localhost:4000

# Public URL of the frontend, allowed to call the auth API. Comma-separate for more than one.
CLIENT_URL=http://localhost:5173

PORT=4000
